{"id":"footer","type":"text","x":40,"y":735,"width":920,"height":58,"text":"简化状态机，仅展示主循环。取消、超时与预算耗尽需另设分支；\n重派任务时，还需拒绝旧执行代次提交的过期结果。","fontSize":22,"fontFamily":3,"lineHeight":1.4,"strokeColor":"#64748b","angle":0,"roughness":0,"opacity":100,"seed":300003}
