---
layout: compress
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "icons": [
    {"src": "{{ '/assets/img/favicons/web-app-manifest-192x192.png' | relative_url }}", "sizes": "192x192", "type": "image/png"},
    {"src": "{{ '/assets/img/favicons/web-app-manifest-512x512.png' | relative_url }}", "sizes": "512x512", "type": "image/png"}
  ],
  "start_url": "{{ '/' | relative_url }}",
  "theme_color": "#1e3a5f",
  "background_color": "#ffffff",
  "display": "standalone"
}
